# System Environment Configuration for RecordHub
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000/api/v1

# Organization Defaults
PRODUCT_NAME=RecordHub
COMPANY_NAME=Academically Global Healthcare Academy
PRIMARY_TIMEZONE=Asia/Kolkata

# MongoDB Replica Set Connection
MONGODB_URI=mongodb://localhost:27017/recordhub?replicaSet=rs0&directConnection=true

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 Storage / MinIO Local Mock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=recordhub-audio-recordings
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Authentication Secrets
JWT_SECRET=super_secret_recordhub_jwt_key_2026_change_in_production
JWT_EXPIRATION=86400

# Pharmlly CRM Integration
PHARMLLY_BASE_URL=https://api.pharmlly.com/v1
PHARMLLY_API_KEY=mock_pharmlly_api_key_academically
PHARMLLY_WEBHOOK_SECRET=mock_webhook_secret_998877

# AI & Speech-to-Text Services
OPENAI_API_KEY=mock_openai_key
ANTHROPIC_API_KEY=mock_anthropic_key
