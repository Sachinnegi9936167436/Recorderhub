{
  "name": "recordhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready sales call monitoring and conversation intelligence platform for Academically Global Healthcare Academy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=apps/api",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
